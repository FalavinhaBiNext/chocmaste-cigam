NODE_ENV=production
PORT=3333
JWT_SECRET=seu_jwt_secret_aqui

# PostgreSQL externo
DB_HOST=187.77.44.253
DB_PORT=5441
DB_USER=chocmaster
DB_PASS=coloque_a_senha_aqui
DB_NAME=chocmastedb

# Bling API v3 OAuth2
BLING_CLIENT_ID=seu_client_id_aqui
BLING_CLIENT_SECRET=seu_client_secret_aqui
BLING_REDIRECT_URI=https://seudominio.com.br/
BLING_SCOPE=all

# Webhook delay entre chamadas da API Bling (ms)
WEBHOOK_DELAY=3000

# CIGAM Integrador (CadastroMateriais.integrador)
CIGAM_INTEGRADOR_URL=http://servidor/CadastroMateriais.integrador.ashx
CIGAM_INTEGRADOR_PIN_HOMOLOGACAO=pin_homologacao_aqui
CIGAM_INTEGRADOR_PIN_PRODUCAO=pin_producao_aqui

# Mercado Livre API OAuth2
ML_APP_ID=seu_app_id_aqui
ML_CLIENT_SECRET=seu_client_secret_aqui
ML_REDIRECT_URI=https://seudominio.com.br/mercado-livre/callback

# Shopee Open Platform API
# SHOPEE_ENV=test usa o host de sandbox (obrigatório para Test Partner_id/Key, app "Developing").
# Troque para SHOPEE_ENV=live quando o app for aprovado e você trocar pelas chaves de produção.
SHOPEE_ENV=test
SHOPEE_PARTNER_ID=seu_partner_id_aqui
SHOPEE_PARTNER_KEY=seu_partner_key_aqui
SHOPEE_REDIRECT_URI=https://seudominio.com.br/shopee/callback

# Tray API OAuth2
TRAY_CONSUMER_KEY=seu_consumer_key_aqui
TRAY_CONSUMER_SECRET=seu_consumer_secret_aqui
TRAY_CALLBACK_URL=https://seudominio.com.br/api/v1/tray/callback
# Domínio da loja Tray (usado para gerar a URL de autorização quando store_domain não é informado)
TRAY_STORE_DOMAIN=urldaloja.com.br
# URL pública que a Tray abre em IFRAME no admin da loja para imprimir a etiqueta.
TRAY_LABEL_URL=https://seudominio.com.br/api/v1/tray/shipping-label/print