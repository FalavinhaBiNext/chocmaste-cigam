    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:generate-sql": "ts-node -r tsconfig-paths/register scripts/generate-esmateri-sql.ts",
    "db:generate-excel": "ts-node -r tsconfig-paths/register scripts/generate-esmateri-excel.ts",
    "test": "vitest"
  },
